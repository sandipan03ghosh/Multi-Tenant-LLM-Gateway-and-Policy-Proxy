# Copy to .env and fill in real values. Never commit .env.

# --- Runtime ---
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info

# --- PostgreSQL (source of truth: config, tenancy, audit, cost ledger) ---
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/llm_gateway
# Used by docker-compose.yml to initialize the postgres container; keep in sync with DATABASE_URL above.
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=llm_gateway

# --- Redis (cache, rate limiting, circuit breaker state, priority queues, pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- Observability stack (docker compose --profile observability up) ---
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
# Where Alertmanager delivers metric-threshold alerts. Leave unset if no webhook receiver.
ALERTMANAGER_WEBHOOK_URL=

# --- Auth ---
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
JWT_ISSUER=llm-gateway
JWT_AUDIENCE=llm-gateway-clients
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# --- Secret encryption (envelope encryption master key for provider credentials) ---
# Self-hosted: a locally-generated key. Cloud: a KMS key reference.
SECRET_ENCRYPTION_MASTER_KEY=replace-with-a-strong-random-key

# --- Provider credentials (only used by adapters-provider-*; never logged) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Admin Web UI ---
# Enables CORS on /admin/v1/* for this one browser origin. Leave unset if not running the Admin
# Web UI or if it's reverse-proxied same-origin. Example: https://admin.example.com
ADMIN_UI_ORIGIN=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_PORT=9100

# --- Seed / demo environment guard ---
ALLOW_SEED=false
