{
  "name": "llm-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Multi-Provider LLM Gateway — monorepo root",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@llm-gateway/adapters-postgres": "workspace:*",
    "@llm-gateway/adapters-redis": "workspace:*",
    "@llm-gateway/application": "workspace:*",
    "@llm-gateway/domain": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
