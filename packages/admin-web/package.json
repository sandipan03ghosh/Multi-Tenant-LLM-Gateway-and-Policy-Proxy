{
  "name": "@llm-gateway/admin-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based Admin UI — a React SPA over the Admin API via @llm-gateway/sdk-node's AdminClient. Builds to a static dist/, deployed independently of the api process.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@llm-gateway/sdk-node": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
