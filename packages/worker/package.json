{
  "name": "@llm-gateway/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background worker composition root — JobScheduler handlers for health polling, budget reconciliation, webhook/alert delivery, audit archival, batch queue draining.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
